{
  "name": "olympic-torch-panic",
  "version": "1.0.0",
  "private": true,
  "description": "Olympic Torch Panic — carry the flame to LA. Plain-JS browser mini game.",
  "type": "module",
  "scripts": {
    "dev": "http-server app -p 8080 -c-1",
    "test": "node --test tests/unit/",
    "test:e2e": "playwright test",
    "lint": "eslint app/js tests",
    "format": "prettier --write \"app/**/*.{js,css,html}\" \"tests/**/*.js\" \"*.json\"",
    "format:check": "prettier --check \"app/**/*.{js,css,html}\" \"tests/**/*.js\" \"*.json\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@playwright/test": "^1.45.0",
    "eslint": "^9.7.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
