{
  "name": "olympic-torch-panic",
  "version": "1.0.0",
  "private": true,
  "description": "Olympic Torch Panic — carry the flame to LA. Plain-JS browser mini game.",
  "type": "module",
  "scripts": {
    "dev": "http-server . -p 8080 -c-1",
    "stop": "node scripts/stop.mjs",
    "test": "node --test tests/unit/",
    "test:e2e": "playwright test",
    "lint": "eslint js tests",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" \"index.html\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"js/**/*.js\" \"css/**/*.css\" \"index.html\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.json\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@playwright/test": "^1.45.0",
    "eslint": "^9.7.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
